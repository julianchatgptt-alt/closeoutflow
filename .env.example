# CloseoutFlow environment contract
# Copy to .env.local for local development. Never commit real credentials.

# Application — APP_ENV is required in staging/production; defaults to local.
APP_ENV=local
BUILD_VERSION=development

# Public browser-safe Supabase values — optional locally, required staging/production.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-public-anon-key

# Server-only Supabase values — optional locally, required staging/production.
# Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=placeholder-server-only-service-role-key

# Background jobs — optional locally; cloud values are deferred to Task 16.
INNGEST_EVENT_KEY=placeholder-server-only-event-key
INNGEST_SIGNING_KEY=placeholder-server-only-signing-key

# Email — optional locally; cloud values are deferred to Task 16.
EMAIL_PROVIDER=noop
RESEND_API_KEY=placeholder-server-only-resend-key
EMAIL_FROM=CloseoutFlow Local <noreply@example.com>

# Logging and error monitoring — optional locally; full setup deferred to Task 17.
LOG_LEVEL=info
SENTRY_DSN=https://placeholder@example.invalid/1
SENTRY_ENABLED=false

# Product analytics — optional; setup deferred to Task 17.
NEXT_PUBLIC_POSTHOG_KEY=placeholder-public-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Rate limiting — optional locally; provider wiring is deferred.
UPSTASH_REDIS_REST_URL=https://placeholder.upstash.io
UPSTASH_REDIS_REST_TOKEN=placeholder-server-only-upstash-token
