{
  "name": "closeoutflow",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.33 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "db:lint": "supabase db lint --local",
    "db:reset": "node scripts/db-reset.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:types": "node scripts/db-types.mjs",
    "db:validate": "node scripts/validate-migrations.mjs",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 && node scripts/check-boundaries.mjs",
    "prepare": "husky",
    "test": "vitest run",
    "test:a11y": "playwright test --grep @a11y",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:server-only": "node scripts/verify-server-only.mjs",
    "typecheck": "turbo run typecheck"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.3",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.8",
    "postcss": "8.5.19",
    "prettier": "3.9.5",
    "supabase": "2.109.1",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "vitest-axe": "0.1.0"
  }
}
